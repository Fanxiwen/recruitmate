# recruitmate 单域名部署示例（配合阿里云个人免费证书）
#
# 布局约定：
#   /var/www/recruitmate/careers/  外部端（careers dist 解包内容）
#   /var/www/recruitmate/hr/       内部端（web dist，构建时 VITE_BASE_PATH=/hr）
#   Go API 运行于 127.0.0.1:8080
#
# 访问：
#   https://域名/           → 求职者外部端
#   https://域名/hr/        → HR 内部端（默认加 Basic Auth 保护）
#   https://域名/api/       → Go API（前后端同域，无跨域问题）
#
# 将 recruit.example.com 替换为证书绑定的真实域名。

server {
    listen 443 ssl;
    http2 on;
    server_name recruit.example.com;

    # 阿里云免费证书（下载 Nginx 格式：.pem + .key）
    ssl_certificate     /etc/nginx/ssl/recruit.pem;
    ssl_certificate_key /etc/nginx/ssl/recruit.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # 上传简历最大 5MB，留余量
    client_max_body_size 6m;

    # ---- 外部端（求职者）----
    location / {
        root /var/www/recruitmate/careers;
        try_files $uri $uri/ /index.html;
    }

    # ---- 内部端（HR，路径 /hr/）----
    location /hr/ {
        auth_basic "HR Console";
        auth_basic_user_file /etc/nginx/.hr-htpasswd;
        root /var/www/recruitmate;
        try_files $uri $uri/ /hr/index.html;
    }

    # ---- API 反代 ---- 
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}

# HTTP → HTTPS 跳转
server {
    listen 80;
    server_name recruit.example.com;
    return 301 https://$host$request_uri;
}
